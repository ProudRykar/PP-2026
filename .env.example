# Database (individual parts — takes priority over DATABASE_URL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=user
DATABASE_PASSWORD=password
DATABASE_NAME=omnichannel
# Optional: full URL override (if set, individual parts are ignored)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/omnichannel

# Telegram
TELEGRAM_BOT_TOKEN=токен

# Slack
# SLACK_BOT_TOKEN=токен
# SLACK_APP_TOKEN=токен

# Discord
# DISCORD_BOT_TOKEN=токен

# VK
# VK_API_TOKEN=токен
# VK_GROUP_ID=токен

# Email
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=email@gmail.com
EMAIL_PASSWORD=пароль
EMAIL_POLL_INTERVAL=60

# Application
DEBUG=true
LOG_LEVEL=INFO

# Authentication
JWT_SECRET=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
